# NomadDesk — Root Environment Variables Example
# Copy to .env.local for local development overrides

# Database (Postgres 17 local container exposed on host port 55188)
DATABASE_URL=postgres://postgres:postgres@localhost:55188/nomaddesk

# Auth (Auth.js v5 Credentials)
NEXTAUTH_URL=http://localhost:3288
NEXTAUTH_SECRET=nomaddesk_jwt_secret_dev
AUTH_SECRET=nomaddesk_jwt_secret_dev

# Port
PORT=3288

# Mailpit (SMTP on host port 11188, Web UI on 18188)
SMTP_HOST=localhost
SMTP_PORT=11188
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NomadDesk <noreply@nomaddesk.com>

# Uploads directory
UPLOAD_DIR=./.data/uploads
